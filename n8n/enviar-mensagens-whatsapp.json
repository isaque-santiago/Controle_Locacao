    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Classificação dos erros da Evolution (a mesma de src/services/evolution.py):\n//   408/429/5xx/rede  -> a mensagem não é culpada: volta para a fila e o fluxo PARA (parar);\n//   401/403/404       -> chave ou instância inválida: PARA sem registrar (a reserva vence sozinha) (parar_sem_registro);\n//   demais 4xx        -> problema só desta mensagem: registra a falha e SEGUE (continuar).\nfunction classificar(r) {\n  if (r.error || r.statusCode === undefined) return { acao: 'parar', erro: 'Sem resposta da Evolution.' };\n  if ([401, 403, 404].includes(r.statusCode)) return { acao: 'parar_sem_registro' };\n  if ([408, 429].includes(r.statusCode)) return { acao: 'parar', erro: `A Evolution pediu para tentar depois (${r.statusCode}).` };\n  if (r.statusCode >= 500) return { acao: 'parar', erro: `A Evolution respondeu ${r.statusCode}.` };\n  if (r.statusCode >= 400) return { acao: 'continuar', erro: `A Evolution recusou o pedido (${r.statusCode}).` };\n  return null;\n}\nconst id = $('Cada mensagem').item.json.id;\nconst r = $json;\nconst falha = classificar(r);\nif (falha) return { json: { id, resultado: 'falhou', ...falha } };\nconst existe = Array.isArray(r.body) && r.body.length > 0 && r.body[0].exists === true;\nif (!existe) return { json: { id, resultado: 'ignorada', acao: 'continuar', erro: 'O número não tem WhatsApp.' } };\nreturn { json: { id, acao: 'enviar' } };\n"
      },
