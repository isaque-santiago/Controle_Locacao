    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Estado da instância do WhatsApp, no mesmo vocabulário do app: open, close (ou outro da Evolution), indisponivel, config_invalida.\nconst r = $input.first().json;\nlet estado;\nif (r.error || r.statusCode === undefined) estado = 'indisponivel';\nelse if ([401, 403, 404].includes(r.statusCode)) estado = 'config_invalida';\nelse if ([408, 429].includes(r.statusCode) || r.statusCode >= 500) estado = 'indisponivel';\nelse { const b = r.body || {}; estado = String((b.instance || b).state || 'desconhecido'); }\nreturn [{ json: { estado, aberta: estado === 'open' } }];\n"
      },
