# Copie para .env (ignorado pelo git) e preencha com o projeto de DESENVOLVIMENTO.
# Em produção use variaveis de ambiente, nunca este arquivo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key

# Dados da empresa LOCADORA que aparecem no contrato em PDF (preâmbulo, fecho e foro).
# Campo vazio ou ausente sai como linha para preencher à mão. Em produção, use variáveis de ambiente (Coolify).
LOCADOR_NOME=Razão social da empresa
LOCADOR_CNPJ=00.000.000/0001-00
LOCADOR_INSCRICAO_ESTADUAL=
LOCADOR_EMAIL=
LOCADOR_TELEFONES=
LOCADOR_ENDERECO=Rua, número, bairro, cidade/UF, CEP
LOCADOR_REPRESENTANTE_NOME=Nome do representante
LOCADOR_REPRESENTANTE_QUALIFICACAO=brasileiro, estado civil, profissão
LOCADOR_REPRESENTANTE_RG=
LOCADOR_REPRESENTANTE_CPF=
LOCADOR_CIDADE=Cidade onde o contrato é assinado
LOCADOR_FORO=Cidade-UF
