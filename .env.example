# Copie para .env (ignorado pelo git) e preencha com o projeto de DESENVOLVIMENTO.
# Em produção use variaveis de ambiente, nunca este arquivo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
# Em produção: chave que cifra o cookie 'lembrar' (sessão de 90 dias sobrevive a deploys). Em desenvolvimento pode ficar vazia.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSAO_CHAVE=
# Conector do claude.ai (opcional; sem a chave fica desligado). Outra chave Fernet, gerada do mesmo jeito. Veja README, 'Conector do claude.ai'.
CONECTOR_CHAVE=
CONECTOR_URL_BASE=
# Usuário de serviço do conector (só executa as RPCs rpc_conector_*; registre em servico_conector). Sem ele, só o ping funciona.
SERVICO_CONECTOR_EMAIL=
SERVICO_CONECTOR_SENHA=

# Dados da empresa LOCADORA que aparecem no contrato em PDF (preâmbulo, fecho e foro).
# Campo vazio ou ausente sai como linha para preencher à mão. Em produção, use variáveis de ambiente (Coolify).
LOCADOR_NOME=Razão social da empresa
# Sem LOCADOR_CNPJ o contrato com promessa de compra trata o locador como pessoa física (usa o representante).
LOCADOR_CNPJ=00.000.000/0001-00
LOCADOR_INSCRICAO_ESTADUAL=
LOCADOR_EMAIL=
LOCADOR_TELEFONES=
LOCADOR_ENDERECO=Rua, número, bairro, cidade/UF, CEP
LOCADOR_REPRESENTANTE_NOME=Nome do representante
LOCADOR_REPRESENTANTE_QUALIFICACAO=brasileiro, estado civil, profissão
LOCADOR_REPRESENTANTE_RG=
LOCADOR_REPRESENTANTE_CPF=
LOCADOR_CIDADE=Cidade onde o contrato é assinado (ex.: Crato/CE)
LOCADOR_FORO=Cidade-UF
