# Dados da empresa LOCADORA que aparecem no contrato em PDF (preâmbulo, fecho e foro).
# Ficam só neste arquivo (fora do git): têm CNPJ e documentos do representante.
# Campo vazio ou ausente sai como linha para preencher à mão.
[locador]
nome = "Razão social da empresa"
cnpj = "00.000.000/0001-00"
inscricao_estadual = ""
email = ""
telefones = ""
endereco = "Rua, número, bairro, cidade/UF, CEP"
representante_nome = "Nome do representante"
representante_qualificacao = "brasileiro, estado civil, profissão"
representante_rg = ""
representante_cpf = ""
cidade = "Cidade onde o contrato é assinado"
foro = "Cidade-UF"
